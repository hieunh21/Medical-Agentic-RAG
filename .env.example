# LLM — chỉ ở server, không commit .env thật
SHOPAIKEY_API_KEY=
GENAI_BASE_URL=https://api.shopaikey.com
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
LLM_MODEL_JUDGE=
LLM_TIMEOUT_MS=30000

# Qdrant
# Dùng 127.0.0.1, đừng dùng localhost: trên Windows localhost làm mỗi request chậm thêm ~2s.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=youmed_medical

# Dữ liệu đã parse — article_index đọc frontmatter từ đây để khớp tên bài
ARTICLES_DIR=data/processed/articles

# Model server (embed + rerank)
MODEL_SERVER_URL=http://127.0.0.1:8001

# Retrieval
DENSE_PREFETCH=40
SPARSE_PREFETCH=40
FUSION_TOP_N=30
RERANK_TOP_K=8
MAX_CHUNKS_PER_ARTICLE=2
FINAL_CONTEXT_K=5
RERANK_CONFIDENT_SCORE=

# Corrective (Phase 2)
MAX_CORRECTIONS=2
COVERAGE_THRESHOLD=0.75

# Agent (Phase 3) — AGENT_ENABLED=false thì route "complex" rơi về hybrid_retrieve
# (eval trên bộ complex n=8 chưa đủ bằng chứng để cắt hẳn, nhưng cũng chưa thắng rõ)
RESEARCH_AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_POOL=12
AGENT_TIMEOUT_S=25

# Hội thoại (Phase 3)
CHECKPOINT_DB=data/sessions.sqlite
HISTORY_TURNS=3

# Observability — trace JSONL (llm / node / request), xem observability/trace.py
TRACE_LOG=data/traces.jsonl

# Eval (tuỳ chọn) — để trống thì LLM-judge dùng chung model với LLM_MODEL_JUDGE,
# tức judge và bên sinh câu trả lời cùng model; đặt model khác để giảm thiên vị.
EVAL_JUDGE_MODEL=

# Tier rẻ cho task phân loại (grade_evidence). Để trống -> dùng LLM_MODEL_FAST.
# grade_evidence gửi cả context nên là task tốn token nhất mỗi câu; đặt model rẻ hơn ở đây
# cắt được chi phí mà không bỏ vòng tự sửa truy vấn.
LLM_MODEL_LITE=

# Số ký tự mỗi đoạn gửi cho grade_evidence (0 = gửi nguyên văn).
GRADE_CHUNK_CHARS=600

# ---------------------------------------------------------------- deploy (xem render.yaml)
# Để trống khi dev. Đặt khi chạy backend không có GPU: embed + rerank gọi Hugging Face ZeroGPU Space
# (deploy/hf_models_space/) qua gradio_client, bằng HF_TOKEN chỉ đọc.
MODEL_SPACE=
HF_TOKEN=
# Qdrant Cloud cần key; Qdrant local (docker compose) để trống.
QDRANT_API_KEY=
# Chỉ dùng cho deploy/migrate_qdrant.py (chép collection local -> cloud): key có quyền ghi.
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
# Frontend được gọi API (phân tách bằng dấu phẩy). Mặc định: frontend dev ở :5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Link demo công khai: 0 = không giới hạn (dev).
RATE_LIMIT_PER_IP_HOUR=0
DAILY_QUESTION_CAP=0
